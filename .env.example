# API (crates/api). Full list and defaults: README.md "Environment (API)".
DATABASE_URL=postgres:///btc_safe_dev?host=/tmp
CHAIN=memory                 # memory = in-process simulator with /dev/*; esplora = real signet
NETWORK=signet
# ESPLORA_URL=https://mempool.space/signet/api
BIND=127.0.0.1:8080
COOKIE_SECURE=false          # only for local http; keep true in any deployment
# WEB_ORIGIN=http://localhost:3000
# CLIENT_IP_HEADER=x-real-ip # only behind a proxy that overwrites this header
# OPEN_SIGNUP=1
# ADMIN_EMAIL=admin@example.com
# ADMIN_SETUP_TOKEN=         # generate with: openssl rand -hex 32
# SIGNUP_SECRET=             # 64 hex chars; needed with more than one API process

# Web (web/). The Next.js dev server proxies /api/* here.
BTC_SAFE_API=http://127.0.0.1:8080
